{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "typst-desktop",
  "version": "2.1.0",
  "identifier": "co.sirblob.typst-desktop",
  "build": {
    "beforeDevCommand": "bun run fetch:sidecars && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run fetch:sidecars && bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Typst Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "publisher": "SirBlobby",
    "copyright": "Copyright (c) 2026 SirBlobby",
    "category": "Productivity",
    "shortDescription": "A desktop editor for Typst",
    "longDescription": "A desktop editor for Typst documents with a built-in compiler, live preview, and optional sync to a TypstDrive server.",
    "homepage": "https://github.com/SirBlobby/typst-desktop.git",
    "licenseFile": "../LICENSE",
    "externalBin": ["binaries/pandoc", "binaries/tinymist"],
    "resources": {
      "binaries/pandoc-COPYRIGHT.txt": "licenses/pandoc-COPYRIGHT.txt",
      "binaries/tinymist-LICENSE.txt": "licenses/tinymist-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libssl3",
          "xdg-utils"
        ]
      },
      "rpm": {
        "depends": [
          "libwebkit2gtk-4.1.so.0()(64bit)",
          "libgtk-3.so.0()(64bit)",
          "libssl.so.3()(64bit)",
          "xdg-utils"
        ]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
